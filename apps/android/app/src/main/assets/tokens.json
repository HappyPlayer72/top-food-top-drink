{
  "$schema": "https://topfood.ro/schemas/design-tokens.v1.json",
  "version": 1,
  "brand": "TopFood & TopDrink",
  "typography": {
    "fontFamily": "Archivo",
    "variableAxes": {
      "widthRange": [62, 125],
      "weightRange": [100, 900]
    },
    "styles": {
      "display": {
        "fontFamily": "Archivo",
        "widthAxis": 62,
        "fontWeight": 800,
        "letterSpacingEm": -0.015
      },
      "displayLight": {
        "fontFamily": "Archivo",
        "widthAxis": 62,
        "fontWeight": 300,
        "letterSpacingEm": -0.01
      },
      "displayRegular": {
        "fontFamily": "Archivo",
        "widthAxis": 62,
        "fontWeight": 400,
        "letterSpacingEm": 0
      },
      "body": {
        "fontFamily": "Archivo",
        "widthAxis": 100,
        "fontWeight": 400,
        "lineHeightMultiplier": 1.5
      }
    }
  },
  "coreColors": {
    "carou": "#B3261E",
    "cafea": "#3A2418",
    "mustar": "#E0A526",
    "placuta": "#2D5130",
    "sticla": "#17382C",
    "chihlimbar": "#F2A33A",
    "spuma": "#F4EEE2",
    "carton": "#B98A5E"
  },
  "themes": {
    "topfoodLight": {
      "background": "#FBF6EA",
      "surface": "#FAF8F5",
      "surfaceElevated": "#F5EFE2",
      "sponsoredSurface": "#F2EFE9",
      "onBackground": "#3A2418",
      "onSurfaceMuted": "#6E5649",
      "border": "#E6DFD5",
      "inputBorder": "#D6CFC5",
      "primary": "#B3261E",
      "onPrimary": "#FFFFFF",
      "secondary": "#3A2418",
      "onSecondary": "#FFFFFF",
      "warning": "#E0A526",
      "onWarning": "#3A2418"
    },
    "topfoodDark": {
      "background": "#211F1D",
      "surface": "#302C29",
      "surfaceElevated": "#302C29",
      "sponsoredSurface": "#2A2623",
      "onBackground": "#F7F1E8",
      "onSurfaceMuted": "#CDC1B5",
      "border": "#443E39",
      "inputBorder": "#524B45",
      "primary": "#B3261E",
      "onPrimary": "#FFFFFF",
      "secondary": "#F7F1E8",
      "onSecondary": "#211F1D",
      "warning": "#E0A526",
      "onWarning": "#3A2418"
    },
    "topdrink": {
      "background": "#17382C",
      "surface": "#143025",
      "surfaceElevated": "#122B22",
      "sponsoredSurface": "#1E4335",
      "onBackground": "#F4EEE2",
      "onSurfaceMuted": "#D8D0C2",
      "border": "#285443",
      "inputBorder": "#2D5947",
      "primary": "#F2A33A",
      "onPrimary": "#17382C",
      "coasterBorder": "#B98A5E",
      "error": "#FF7A70"
    }
  },
  "badges": {
    "localnicLight": {
      "background": "#2D5130",
      "foreground": "#FFFFFF",
      "border": "#2D5130",
      "softBackground": "rgba(45, 81, 48, 0.12)"
    },
    "localnicDark": {
      "background": "#AED3A8",
      "foreground": "#132A15",
      "border": "#AED3A8",
      "softBackground": "rgba(174, 211, 168, 0.16)"
    },
    "turistLight": {
      "background": "transparent",
      "foreground": "#6B4F2A",
      "border": "#A78452"
    },
    "turistDark": {
      "background": "transparent",
      "foreground": "#E3CDA6",
      "border": "#E3CDA6"
    },
    "trap": {
      "background": "#B3261E",
      "foreground": "#FFFFFF"
    },
    "possibleTrap": {
      "background": "#E0A526",
      "foreground": "#3A2418"
    },
    "coaster": {
      "background": "#F4EEE2",
      "foreground": "#17382C",
      "border": "#B98A5E"
    }
  },
  "radiiDp": {
    "badge": 3,
    "button": 4,
    "card": 6,
    "panel": 12,
    "coaster": 9999
  },
  "touchTargetMinDp": 44,
  "motion": {
    "easings": {
      "easeOut": [0.23, 1, 0.32, 1],
      "easeInOut": [0.77, 0, 0.175, 1],
      "drawer": [0.32, 0.72, 0, 1]
    },
    "durationsMs": {
      "press": 150,
      "rowTransition": 180,
      "photoZoom": 260
    }
  }
}
