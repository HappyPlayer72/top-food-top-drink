# Baza de date (docker compose up -d db pornește una locală cu aceste date)
DATABASE_URL=postgresql://topfood:topfood@localhost:5432/topfood

# Ingestie (fără ele, joburile de ingestie sunt sărite; demo-ul merge pe datele din seed/)
GOOGLE_PLACES_API_KEY=
# Opțional: adresa unui local adăugat de mână → coordonate reale (geoapify.com, date OpenStreetMap)
GEOAPIFY_API_KEY=
GOOGLE_ROUTES_API_KEY=
TRIPADVISOR_API_KEY=
# Token de aplicație Meta pentru oEmbed Instagram/Facebook (TikTok și YouTube merg fără)
META_OEMBED_TOKEN=

# Claude Haiku pentru aspectele review-urilor (fără cheie se folosește dicționarul local)
ANTHROPIC_API_KEY=
# 1 = seed-ul folosește Claude pentru aspecte (costă bani); altfel dicționarul local
SEED_USE_CLAUDE=

# Sesiuni: minim 32 de caractere aleatorii (ex. `openssl rand -base64 48`)
SESSION_SECRET=
# Demo: codul fix pentru revendicarea unui local prin telefon (gol = cod aleator)
DEMO_CLAIM_CODE=123456

# După hackathon
STRIPE_SECRET_KEY=

# Site
# Adresa publică (pentru sitemap.xml și linkurile canonice), ex. https://topfood.vercel.app
SITE_URL=
# „Acces rapid cu un cont de test” la login: mereu pornit local; în producție doar cu on
DEMO_LOGIN=off
# Demo: „Scanează la casă” pune ștampila fără QR (off = doar cu codul real al localului)
DEMO_SCAN=on
# Demo: „Sunt aici acum” la review simulează locația (off = check-in GPS real, la max. 100 m de local)
DEMO_VISIT_GPS=on
# Demo: codul de verificare pentru emailul universitar apare pe ecran (off = trimis pe email)
DEMO_EMAIL_CODES=on

# Bază de date prin pool (Neon „-pooler”, Supabase :6543): prepared statements oprite automat.
# DATABASE_PREPARE=false le oprește explicit; DATABASE_POOL_MAX=3 pe serverless.
DATABASE_PREPARE=
DATABASE_POOL_MAX=
